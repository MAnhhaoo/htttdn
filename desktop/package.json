{
  "name": "htttdn-desktop",
  "productName": "HTTT Shop",
  "version": "1.0.0",
  "description": "Desktop app (Electron wrapper) for the HTTT user frontend",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "build:web": "npm --prefix ../frontend run build",
    "dist": "npm run build:web && electron-builder --win",
    "pack": "npm run build:web && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.httt.shop.desktop",
    "productName": "HTTT Shop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "YOUR_GITHUB_REPO"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
